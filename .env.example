# MergesPDF Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit real secrets to the repository.

# Supabase project configuration
# Get these from your Lovable Cloud / Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase service role key — used only by backend Edge Functions
# Not available on Lovable Cloud; managed automatically by the platform
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lovable AI Gateway key — used by AI-powered tools (summarize, translate, etc.)
LOVABLE_API_KEY=your-lovable-api-key

# Resend API key — used for contact form, review, and survey emails
RESEND_API_KEY=your-resend-api-key

# Optional: Google AdSense publisher ID (public, safe to expose)
VITE_GOOGLE_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx

# Optional: Google Analytics 4 measurement ID (public, safe to expose)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
